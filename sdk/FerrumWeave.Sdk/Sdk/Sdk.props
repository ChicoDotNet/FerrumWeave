<Project>
  <PropertyGroup>
    <FerrumWeaveImportsMicrosoftNETSdk Condition="'$(UsingMicrosoftNETSdk)' != 'true'">true</FerrumWeaveImportsMicrosoftNETSdk>
  </PropertyGroup>
  <Import Project="$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk/Sdk/Sdk.props" Condition="'$(FerrumWeaveImportsMicrosoftNETSdk)' == 'true'" />
  <PropertyGroup>
    <FerrumWeaveSdk>true</FerrumWeaveSdk>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <OutputType>Exe</OutputType>

    <FerrumWeaveSdkPackageRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</FerrumWeaveSdkPackageRoot>
    <FerrumWeavePackagedBackendManifest>$([System.IO.Path]::GetFullPath('$(FerrumWeaveSdkPackageRoot)/tools/compiler/codegen-backend/Cargo.toml'))</FerrumWeavePackagedBackendManifest>
    <FerrumWeavePackageMode Condition="Exists('$(FerrumWeavePackagedBackendManifest)')">true</FerrumWeavePackageMode>

    <!-- Checkout fallback retained for repository tests and contributor workflows. -->
    <FerrumWeaveRepoRoot Condition="'$(FerrumWeavePackageMode)' != 'true' and '$(FerrumWeaveRepoRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../..'))</FerrumWeaveRepoRoot>
  </PropertyGroup>
</Project>
