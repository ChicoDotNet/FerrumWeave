<Project>
  <PropertyGroup>
    <FerrumWeaveImportsMicrosoftNETSdk Condition="'$(UsingMicrosoftNETSdk)' != 'true'">true</FerrumWeaveImportsMicrosoftNETSdk>
  </PropertyGroup>
  <Import Project="$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk/Sdk/Sdk.props" Condition="'$(FerrumWeaveImportsMicrosoftNETSdk)' == 'true'" />
  <PropertyGroup>
    <FerrumWeaveSdk>true</FerrumWeaveSdk>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <OutputType>Exe</OutputType>
    <FerrumWeaveSdkRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</FerrumWeaveSdkRoot>
    <FerrumWeaveCompilerManifest Condition="Exists('$(FerrumWeaveSdkRoot)/compiler/cil/Cargo.toml')">$(FerrumWeaveSdkRoot)/compiler/cil/Cargo.toml</FerrumWeaveCompilerManifest>
    <FerrumWeaveCompilerManifest Condition="'$(FerrumWeaveCompilerManifest)' == ''">$([System.IO.Path]::GetFullPath('$(FerrumWeaveSdkRoot)/../../compiler/cil/Cargo.toml'))</FerrumWeaveCompilerManifest>
  </PropertyGroup>
</Project>
